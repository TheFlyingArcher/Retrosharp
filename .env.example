# Copy to .env and fill in real values. .env itself is git-ignored.

POSTGRES_DB=Retrosharp
POSTGRES_USER=retrosharp
POSTGRES_PASSWORD=change-me

RABBITMQ_DEFAULT_USER=retrosharp
RABBITMQ_DEFAULT_PASS=change-me

# Consumed by RetrosharpConfiguration via .NET's standard double-underscore
# environment-variable configuration binding (ConnectionStrings:DefaultConnection).
# The host here is the docker-compose service name, not localhost.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=Retrosharp;Username=retrosharp;Password=change-me
ConnectionStrings__RabbitMQ=host=rabbitmq;username=retrosharp;password=change-me

# Bulk Game Event import tuning (Retrosharp.Engine.Console). All optional -- the
# defaults below are also the built-in fallbacks. See spec/bulk-import.md.
# BulkImport__DefaultBatchSize=10
# BulkImport__WatchdogTimeoutHours=6

# Retrosheet auto-download (Retrosharp.Engine.Console). The engine fetches season
# game-log and event archives from Retrosheet itself given only a season year; all
# optional. See spec/retrosheet-auto-download.md.
# RetrosheetSource__BaseUrl=https://www.retrosheet.org/
# RetrosheetSource__HttpTimeoutSeconds=100
# Where the engine downloads and extracts archives (a per-run subdirectory,
# cleaned up when the run finishes). docker-compose.yml already sets this to the
# retrosheet-import-data named volume mounted into retrosharp-engine-console --
# required so every engine replica sees the same extracted files under
# `--scale retrosharp-engine-console=N` (see spec/stress-testing.md Step 6).
# Only override this if you're not using that compose file, and if you do,
# make sure whatever path you point at is shared across every engine replica.
# RetrosheetSource__WorkingRoot=
