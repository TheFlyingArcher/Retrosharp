{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=Retrosharp;Username=retrosharp;Password=change-me",
    "RabbitMQ": "host=localhost;username=guest;password=guest"
  },
  "Messaging": {
    "EndpointName": "Retrosharp.Engine",
    "ErrorQueue": "Retrosharp.Engine.Errors",
    "AuditQueue": "Retrosharp.Engine.Audit",
    "SqlPersistenceSchema": "public",
    "SqlPersistenceTablePrefix": "",
    "ImmediateRetries": 3,
    "DelayedRetries": 5,
    "InitialRetryDelaySeconds": 2
  },
  "BulkImport": {
    "DefaultBatchSize": 10,
    "WatchdogTimeoutHours": 6
  },
  "RetrosheetSource": {
    "BaseUrl": "https://www.retrosheet.org/",
    "GameLogArchivePath": "gamelogs/gl{season}.zip",
    "EventArchivePath": "events/{season}eve.zip",
    "BioFileArchivePath": "biofile.zip",
    "WorkingRoot": "",
    "HttpTimeoutSeconds": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "NServiceBus": "Information"
    }
  }
}
